# ================================
# CONFIGURACIÓN DEL MICROSERVICIO DE WEB SCRAPING
# ================================

# Configuración del servidor HTTP
PORT=8080                    # Puerto donde correrá el servicio de scraping
GIN_MODE=release            # Modo de Gin: debug, release, test

# Configuración de MySQL
DB_HOST=localhost           # Host de la base de datos
DB_PORT=3312               # Puerto de MySQL (cambiado para evitar conflictos)
DB_USER=root               # Usuario de la base de datos
DB_PASSWORD=password       # Contraseña de la base de datos
DB_NAME=book_prices        # Nombre de la base de datos

# Configuración de web scraping
SCRAPING_TIMEOUT=30        # Timeout en segundos para las peticiones de scraping
USER_AGENT=BookScraper/1.0 # User-Agent para las peticiones web
MAX_RETRIES=3              # Número máximo de reintentos por sitio web

# Fuentes de web scraping (separadas por comas)
SCRAPING_SOURCES=buscalibre,panamericana

# URLs base de las tiendas para scraping
BUSCALIBRE_BASE_URL=https://www.buscalibre.com.co
PANAMERICANA_BASE_URL=https://www.panamericana.com.co